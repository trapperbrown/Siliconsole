{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Siliconsole",
  "mainBinaryName": "Siliconsole",
  "version": "1.3.0",
  "identifier": "com.siliconsole.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Siliconsole",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false,
        "center": true
      },
      {
        "label": "overlay",
        "title": "Siliconsole Overlay",
        "url": "index.html?view=overlay",
        "width": 520,
        "height": 360,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../sensor-service/publish/sensor-service.exe": "sensor-service/sensor-service.exe",
      "../../sensor-service/publish/defaults.json": "sensor-service/defaults.json",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../LICENSE": "LICENSE.txt"
    },
    "publisher": "Siliconsole",
    "copyright": "Siliconsole contributors",
    "shortDescription": "Hardware info and sensor monitor",
    "category": "Utility",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "license": "MIT",
    "licenseFile": "../../LICENSE"
  }
}
