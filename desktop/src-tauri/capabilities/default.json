{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main and overlay windows",
  "windows": ["main", "overlay", "overlay-*"],
  "permissions": [
    "core:default",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://github.com/trapperbrown/Siliconsole" }, { "url": "https://github.com/trapperbrown/Siliconsole/*" }] }
  ]
}
