{
  "$schema": "../schemas/dashboard.schema.json",
  "schemaVersion": 1,
  "id": "gpu",
  "name": "GPU",
  "description": "Graphics card deep dive: temperatures, load, power, clocks, VRAM, engine charts and fans.",
  "widgets": [
    { "id": "gpu-temp", "type": "radialGauge", "x": 0, "y": 0, "w": 4, "h": 6, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["GpuNvidia", "GpuAmd", "GpuIntel"], "sensorTypes": ["Temperature"], "namePattern": "^GPU Core$", "limit": 1, "expand": "all" },
      "settings": { "label": "GPU Temp", "decimals": 0, "min": 20, "max": 100, "warning": 75, "critical": 85 } },
    { "id": "gpu-hotspot", "type": "radialGauge", "x": 4, "y": 0, "w": 4, "h": 6, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["GpuNvidia", "GpuAmd", "GpuIntel"], "sensorTypes": ["Temperature"], "namePattern": "Hot ?Spot", "limit": 1, "expand": "all" },
      "settings": { "label": "Hotspot", "decimals": 0, "min": 20, "max": 110, "warning": 85, "critical": 95 } },
    { "id": "gpu-vram-temp", "type": "radialGauge", "x": 8, "y": 0, "w": 4, "h": 6, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["GpuNvidia", "GpuAmd", "GpuIntel"], "sensorTypes": ["Temperature"], "namePattern": "Memory Junction", "limit": 1, "expand": "all" },
      "settings": { "label": "VRAM Junction", "decimals": 0, "min": 20, "max": 110, "warning": 90, "critical": 100 } },
    { "id": "gpu-load", "type": "radialGauge", "x": 12, "y": 0, "w": 4, "h": 6, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["GpuNvidia", "GpuAmd", "GpuIntel"], "sensorTypes": ["Load"], "namePattern": "^GPU Core$", "limit": 1, "expand": "all" },
      "settings": { "label": "GPU Load", "decimals": 0, "min": 0, "max": 100 } },
    { "id": "gpu-power", "type": "bigNumber", "x": 16, "y": 0, "w": 4, "h": 3, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["GpuNvidia", "GpuAmd", "GpuIntel"], "sensorTypes": ["Power"], "namePattern": "^GPU (Package|Power|Core)$", "limit": 1, "expand": "all" },
      "settings": { "label": "Power", "decimals": 0 } },
    { "id": "gpu-clock", "type": "bigNumber", "x": 20, "y": 0, "w": 4, "h": 3, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["GpuNvidia", "GpuAmd", "GpuIntel"], "sensorTypes": ["Clock"], "namePattern": "^GPU Core$", "limit": 1, "expand": "all" },
      "settings": { "label": "Core Clock", "decimals": 0 } },
    { "id": "gpu-mem-clock", "type": "bigNumber", "x": 16, "y": 3, "w": 4, "h": 3, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["GpuNvidia", "GpuAmd", "GpuIntel"], "sensorTypes": ["Clock"], "namePattern": "^GPU Memory$", "limit": 1, "expand": "all" },
      "settings": { "label": "Memory Clock", "decimals": 0 } },
    { "id": "gpu-vram", "type": "bigNumber", "x": 20, "y": 3, "w": 4, "h": 3, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["GpuNvidia", "GpuAmd", "GpuIntel"], "sensorTypes": ["SmallData"], "namePattern": "^GPU Memory Used$", "limit": 1, "expand": "all" },
      "settings": { "label": "VRAM Used", "decimals": 0 } },
    { "id": "gpu-engines", "type": "lineChart", "x": 0, "y": 6, "w": 12, "h": 8, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["GpuNvidia", "GpuAmd", "GpuIntel"], "sensorTypes": ["Load"], "namePattern": "^GPU Core$|^GPU Memory Controller$|^GPU Video Engine$|^D3D Video Encode$", "limit": 4, "expand": "all" },
      "settings": { "label": "GPU Engines", "decimals": 0, "min": 0, "max": 100, "historySeconds": 300 } },
    { "id": "gpu-power-chart", "type": "lineChart", "x": 12, "y": 6, "w": 8, "h": 8, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["GpuNvidia", "GpuAmd", "GpuIntel"], "sensorTypes": ["Power"], "namePattern": "^GPU (Package|Power|Core)$", "limit": 1, "expand": "all" },
      "settings": { "label": "GPU Power", "decimals": 0, "historySeconds": 300 } },
    { "id": "gpu-fans", "type": "fanList", "x": 20, "y": 6, "w": 4, "h": 8, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["GpuNvidia", "GpuAmd", "GpuIntel"], "sensorTypes": ["Fan"], "expand": "all" },
      "settings": { "label": "GPU Fans" } }
  ]
}
