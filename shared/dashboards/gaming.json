{
  "$schema": "../schemas/dashboard.schema.json",
  "schemaVersion": 1,
  "id": "gaming",
  "name": "Gaming",
  "description": "GPU and CPU temperatures, load and clocks, history charts and per-core load.",
  "widgets": [
    { "id": "gpu-temp", "type": "radialGauge", "x": 0, "y": 0, "w": 4, "h": 6, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["GpuNvidia", "GpuAmd", "GpuIntel"], "sensorTypes": ["Temperature"], "namePattern": "^GPU Core$", "limit": 1, "expand": "all" },
      "settings": { "label": "GPU Temp", "decimals": 0, "min": 20, "max": 100, "warning": 75, "critical": 85 } },
    { "id": "gpu-hotspot", "type": "radialGauge", "x": 4, "y": 0, "w": 4, "h": 6, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["GpuNvidia", "GpuAmd", "GpuIntel"], "sensorTypes": ["Temperature"], "namePattern": "Hot ?Spot", "limit": 1, "expand": "all" },
      "settings": { "label": "GPU Hotspot", "decimals": 0, "min": 20, "max": 110, "warning": 85, "critical": 95 } },
    { "id": "gpu-vram", "type": "radialGauge", "x": 8, "y": 0, "w": 4, "h": 6, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["GpuNvidia", "GpuAmd", "GpuIntel"], "sensorTypes": ["Temperature"], "namePattern": "Memory Junction", "limit": 1, "expand": "all" },
      "settings": { "label": "VRAM Junction", "decimals": 0, "min": 20, "max": 110, "warning": 90, "critical": 100 } },
    { "id": "cpu-temp", "type": "radialGauge", "x": 12, "y": 0, "w": 4, "h": 6, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["Cpu"], "sensorTypes": ["Temperature"], "namePattern": "Package|Tctl", "limit": 1, "expand": "all" },
      "settings": { "label": "CPU Package", "decimals": 0, "min": 20, "max": 100, "warning": 80, "critical": 90 } },
    { "id": "gpu-load", "type": "bigNumber", "x": 16, "y": 0, "w": 4, "h": 3, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["GpuNvidia", "GpuAmd", "GpuIntel"], "sensorTypes": ["Load"], "namePattern": "^GPU Core$", "limit": 1, "expand": "all" },
      "settings": { "label": "GPU Load", "decimals": 0, "warning": 95, "critical": 99 } },
    { "id": "cpu-load", "type": "bigNumber", "x": 20, "y": 0, "w": 4, "h": 3, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["Cpu"], "sensorTypes": ["Load"], "namePattern": "^CPU Total$", "limit": 1, "expand": "all" },
      "settings": { "label": "CPU Load", "decimals": 0, "warning": 90, "critical": 98 } },
    { "id": "gpu-clock", "type": "bigNumber", "x": 16, "y": 3, "w": 4, "h": 3, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["GpuNvidia", "GpuAmd", "GpuIntel"], "sensorTypes": ["Clock"], "namePattern": "^GPU Core$", "limit": 1, "expand": "all" },
      "settings": { "label": "GPU Clock", "decimals": 0 } },
    { "id": "vram-clock", "type": "bigNumber", "x": 20, "y": 3, "w": 4, "h": 3, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["GpuNvidia", "GpuAmd", "GpuIntel"], "sensorTypes": ["Clock"], "namePattern": "^GPU Memory$", "limit": 1, "expand": "all" },
      "settings": { "label": "Memory Clock", "decimals": 0 } },
    { "id": "temps-chart", "type": "lineChart", "x": 0, "y": 6, "w": 12, "h": 8, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["GpuNvidia", "GpuAmd", "GpuIntel", "Cpu"], "sensorTypes": ["Temperature"], "namePattern": "^GPU Core$|Hot ?Spot|Memory Junction|Package|Tctl", "limit": 4, "expand": "all" },
      "settings": { "label": "Temperatures", "decimals": 0, "historySeconds": 300 } },
    { "id": "load-chart", "type": "lineChart", "x": 12, "y": 6, "w": 12, "h": 8, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["GpuNvidia", "GpuAmd", "GpuIntel", "Cpu"], "sensorTypes": ["Load"], "namePattern": "^GPU Core$|^CPU Total$", "limit": 2, "expand": "all" },
      "settings": { "label": "GPU and CPU Load", "decimals": 0, "min": 0, "max": 100, "historySeconds": 300 } },
    { "id": "cores", "type": "coreHeatmap", "x": 0, "y": 14, "w": 24, "h": 6, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["Cpu"], "sensorTypes": ["Load"], "namePattern": "^CPU Core #\\d+$", "expand": "all" },
      "settings": { "label": "Per-core load", "min": 0, "max": 100 } }
  ]
}
