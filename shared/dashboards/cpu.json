{
  "$schema": "../schemas/dashboard.schema.json",
  "schemaVersion": 1,
  "id": "cpu",
  "name": "CPU",
  "description": "Temperature, load, power, clocks and voltage, plus a heatmap and clock chart for every core.",
  "widgets": [
    { "id": "cpu-temp", "type": "radialGauge", "x": 0, "y": 0, "w": 4, "h": 6, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["Cpu"], "sensorTypes": ["Temperature"], "namePattern": "Package|Tctl", "limit": 1, "expand": "all" },
      "settings": { "label": "CPU Temp", "decimals": 0, "min": 20, "max": 100, "warning": 80, "critical": 90 } },
    { "id": "cpu-load", "type": "radialGauge", "x": 4, "y": 0, "w": 4, "h": 6, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["Cpu"], "sensorTypes": ["Load"], "namePattern": "^CPU Total$", "limit": 1, "expand": "all" },
      "settings": { "label": "CPU Load", "decimals": 0, "min": 0, "max": 100, "warning": 90, "critical": 98 } },
    { "id": "cpu-power", "type": "bigNumber", "x": 8, "y": 0, "w": 4, "h": 3, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["Cpu"], "sensorTypes": ["Power"], "namePattern": "Package", "limit": 1, "expand": "all" },
      "settings": { "label": "Package Power", "decimals": 0 } },
    { "id": "cpu-clock", "type": "bigNumber", "x": 8, "y": 3, "w": 4, "h": 3, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["Cpu"], "sensorTypes": ["Clock"], "namePattern": "^Cores \\(Average\\)$", "limit": 1, "expand": "all" },
      "settings": { "label": "Average Clock", "decimals": 0 } },
    { "id": "cpu-max-core", "type": "bigNumber", "x": 12, "y": 0, "w": 4, "h": 3, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["Cpu"], "sensorTypes": ["Load"], "namePattern": "^CPU Core Max$", "limit": 1, "expand": "all" },
      "settings": { "label": "Busiest Core", "decimals": 0 } },
    { "id": "cpu-vcore", "type": "bigNumber", "x": 12, "y": 3, "w": 4, "h": 3, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["Cpu", "SuperIO"], "sensorTypes": ["Voltage"], "namePattern": "^Vcore$|^CPU Core$", "limit": 1, "expand": "all" },
      "settings": { "label": "Vcore", "decimals": 3 } },
    { "id": "cpu-temps", "type": "lineChart", "x": 16, "y": 0, "w": 8, "h": 6, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["Cpu", "SuperIO"], "sensorTypes": ["Temperature"], "namePattern": "Package|Tctl|CCD|^CPU Core$|VRM", "limit": 6, "expand": "all" },
      "settings": { "label": "CPU and VRM Temps", "decimals": 0, "historySeconds": 300 } },
    { "id": "cores", "type": "coreHeatmap", "x": 0, "y": 6, "w": 24, "h": 5, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["Cpu"], "sensorTypes": ["Load"], "namePattern": "^CPU Core #\\d+$", "expand": "all" },
      "settings": { "label": "Per-core load", "min": 0, "max": 100 } },
    { "id": "core-clocks", "type": "lineChart", "x": 0, "y": 11, "w": 12, "h": 8, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["Cpu"], "sensorTypes": ["Clock"], "namePattern": "^(CPU )?Core #\\d+$", "limit": 16, "expand": "all" },
      "settings": { "label": "Core Clocks", "decimals": 0, "historySeconds": 300 } },
    { "id": "cpu-power-chart", "type": "lineChart", "x": 12, "y": 11, "w": 12, "h": 8, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["Cpu"], "sensorTypes": ["Power"], "limit": 4, "expand": "all" },
      "settings": { "label": "CPU Power", "decimals": 0, "historySeconds": 300 } }
  ]
}
