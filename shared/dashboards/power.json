{
  "$schema": "../schemas/dashboard.schema.json",
  "schemaVersion": 1,
  "id": "power",
  "name": "Power and voltages",
  "description": "CPU and GPU power draw over time, core voltages, and the motherboard's 12V, 5V and 3.3V rails.",
  "widgets": [
    { "id": "cpu-power", "type": "bigNumber", "x": 0, "y": 0, "w": 6, "h": 3, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["Cpu"], "sensorTypes": ["Power"], "namePattern": "Package", "limit": 1, "expand": "all" },
      "settings": { "label": "CPU Power", "decimals": 0 } },
    { "id": "gpu-power", "type": "bigNumber", "x": 6, "y": 0, "w": 6, "h": 3, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["GpuNvidia", "GpuAmd", "GpuIntel"], "sensorTypes": ["Power"], "namePattern": "^GPU (Package|Power|Core)$", "limit": 1, "expand": "all" },
      "settings": { "label": "GPU Power", "decimals": 0 } },
    { "id": "cpu-vcore", "type": "bigNumber", "x": 12, "y": 0, "w": 6, "h": 3, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["Cpu", "SuperIO"], "sensorTypes": ["Voltage"], "namePattern": "^Vcore$|^CPU Core$", "limit": 1, "expand": "all" },
      "settings": { "label": "CPU Vcore", "decimals": 3 } },
    { "id": "gpu-voltage", "type": "bigNumber", "x": 18, "y": 0, "w": 6, "h": 3, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["GpuNvidia", "GpuAmd", "GpuIntel"], "sensorTypes": ["Voltage"], "namePattern": "^GPU Core( Voltage)?$", "limit": 1, "expand": "all" },
      "settings": { "label": "GPU Voltage", "decimals": 3 } },
    { "id": "power-chart", "type": "lineChart", "x": 0, "y": 3, "w": 16, "h": 8, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["Cpu", "GpuNvidia", "GpuAmd", "GpuIntel"], "sensorTypes": ["Power"], "namePattern": "Package|^GPU (Power|Core)$", "limit": 3, "expand": "all" },
      "settings": { "label": "CPU and GPU Power", "decimals": 0, "historySeconds": 300 } },
    { "id": "rail", "type": "sparkline", "x": 16, "y": 3, "w": 4, "h": 4, "sensorIds": [],
      "sensorQuery": { "hardwareTypes": ["SuperIO"], "sensorTypes": ["Voltage"], "namePattern": "^(\\+12V|\\+5V|\\+3\\.3V|DIMM)$", "limit": 4, "expand": "each" },
      "settings": { "decimals": 3, "historySeconds": 300 } }
  ]
}
